# ---------------------------------------------------------------------------
# Production environment for the VPS deployment (docker compose).
# Copy to .env.production on the server and fill in real values.
# NEVER commit the filled-in file — it stays server-side only.
# ---------------------------------------------------------------------------

# Postgres container credentials. Only reachable from other containers on
# this compose network, never exposed to the internet, but still use a real
# random password, not "postgres".
# Generate with: openssl rand -base64 32
POSTGRES_USER=itpf
POSTGRES_PASSWORD=
POSTGRES_DB=itpf

# Built from the Postgres values above — service name "postgres" is the
# container's hostname on the compose network.
DATABASE_URL=postgresql://itpf:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/itpf

# 32+ byte random string used to sign session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
